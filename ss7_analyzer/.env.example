# SS7 Analyzer environment variables
# Copy to .env and adjust as needed

# Override config values with SS7_ prefix
SS7_MAX_PCAP_SIZE_MB=500
SS7_TSHARK_TIMEOUT_SEC=60
SS7_TSHARK_BINARY=tshark

# GeoIP (optional)
SS7_GEOIP_ENABLED=false
SS7_GEOIP_DATABASE_PATH=

# State
SS7_STATE_SQLITE_PATH=ss7_analyzer_state.db

# Logging
SS7_LOGGING_LEVEL=INFO
SS7_LOGGING_FORMAT=json
